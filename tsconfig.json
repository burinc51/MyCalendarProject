{
    "extends": "expo/tsconfig.base",
    "compilerOptions": {
        "strict": false,
        "types": [
            "nativewind/types"
        ],
        "jsx": "react-jsx",
        "paths": {
            "@/*": [
                "./*"
            ]
        }
    },
    "include": [
        "**/*.ts",
        "**/*.tsx",
        ".expo/types/**/*.ts",
        "expo-env.d.ts",
        "nativewind.d.ts",
        "nativewind-env.d.ts",
        "constants/colors.js",
        "utils/downloadJson.js"
    ]
}
